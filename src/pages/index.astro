---
import asciiArt from "@/assets/ascii-art.txt?raw"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { formatDate } from "@/lib/utils"

const recentPosts = (await getPosts()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />
  <home-intro>
    <h1>Hi, I'm Akmal.</h1>
    <prose-content>
      <p>
        I'm a data scientist based in Jakarta, with over eight years of
        experience building analytics and machine learning solutions for retail
        banking. I've worked across major institutions including Citi and UOB,
        and currently consult for Visa Indonesia, focusing on turning complex
        data into practical, business-moving decisions.
      </p>
      <p>
        Alongside my day job, I teach Python for data analytics at RevoU,
        helping others build the same skills I rely on every day.
      </p>
      <p>
        My academic background spans mathematics and economics — a B.Sc. in
        Mathematics from Institut Teknologi Bandung, and a Master's in Economics
        and Finance from the Barcelona Graduate School of Economics — rounded
        out more recently with a Master's in Artificial Intelligence.
      </p>
      <p>
        Feel free to reach out at
        <a href="mailto:akmal.fadhlurrahman@gmail.com"
          >akmal.fadhlurrahman@gmail.com</a
        >, or find me through the links below.
      </p>
    </prose-content>
    <hr>
    <section>
      <h2>Recent posts</h2>
      <ul>
        {recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}
              >{formatDate(post.data.date)}</time
            >
          </li>
        ))}
      </ul>
    </section>
    <ascii-art aria-hidden="true"><pre>{asciiArt}</pre></ascii-art>
  </home-intro>
</Layout>

<style>
  home-intro {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-xs);
    }

    prose-content {
      display: block;

      p + p {
        margin-block-start: var(--space-xs);
      }
    }

    hr {
      margin-block: var(--space-l);
      border: none;
      border-block-start: 2px solid var(--border);
    }

    section {
      h2 {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
        color: var(--foreground);
        margin-block-end: var(--space-s);
      }

      ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
      }

      li {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-s);

        a {
          color: var(--foreground);
        }

        time {
          flex-shrink: 0;
          font-size: var(--step--1);
          color: var(--muted-foreground);
        }
      }
    }

    ascii-art {
      display: block;
      container-type: inline-size;
      margin-block-start: var(--space-l);

      pre {
        font-family: var(--font-mono);
        font-size: 2.1cqw;
        line-height: 1.15;
        white-space: pre;
        overflow: hidden;
      }

      @media (width >= 64rem) {
        position: fixed;
        inset-block: var(--page-offset-top) var(--page-offset-bottom);
        inset-inline-end: var(--grid-edge);
        inline-size: calc(
          3 *
          var(--grid-column-width) +
          2 *
          var(--grid-gutter)
        );
        margin-block-start: 0;
        display: flex;
        align-items: center;
      }
    }
  }
</style>
