---
import asciiArt from "@/assets/ascii-art.txt?raw"
import ArrowRight from "@/assets/icons/arrow-right.svg"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { formatDate } from "@/lib/utils"
import BSELogo from "@/assets/logos/bse.svg"
import CitiLogo from "@/assets/logos/citi.svg"
import ITBLogo from "@/assets/logos/itb.svg"
import MaybankLogo from "@/assets/logos/maybank.svg"
import UdacityLogo from "@/assets/logos/udacity.svg"
import UOBLogo from "@/assets/logos/uob.svg"
import VisaLogo from "@/assets/logos/visa.svg"

const recentPosts = (await getPosts()).slice(0, 3)
const atMaybank = Date.now() >= Date.parse("2026-09-07")
---

<style>
  dim-span {
    opacity: 0.6;
  }

  delta-down {
    color: light-dark(oklch(48% 0.12 150), oklch(83% 0.1 150));
  }

  click-counter button {
    padding: var(--space-3xs) var(--space-2xs);
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }
</style>

<Layout>
  <MetaPage slot="head" />
  <home-intro>
    <h1>Hi, I'm Akmal.</h1>
    <prose-content>
      <p>
        I'm a data scientist based in
        <a
          href="https://www.google.com/maps/place/Jakarta,+Indonesia/"
          target="_blank"
          rel="noopener noreferrer"
          >Jakarta, Indonesia</a
        >
        with over eight years of experience building analytics and machine
        learning solutions for financial institutions
        <dim-span>(especially retail banking)</dim-span>. I've worked across
        major institutions including
        <inst-logo class="nudge-up"><CitiLogo /></inst-logo>
        and
        <inst-logo><UOBLogo /></inst-logo>
        {atMaybank ? (
            <>, and <inst-logo><VisaLogo /></inst-logo>Visa Indonesia, and currently
        work at <inst-logo class="badge"><MaybankLogo /></inst-logo>Maybank</>
          ) : (
            <>, and currently consult for <inst-logo><VisaLogo /></inst-logo>Visa Indonesia</>
          )}, focusing on turning complex data into practical, business-moving
        decisions.
      </p>
      <p>
        Alongside my day job, I teach Python for data analytics at RevoU,
        helping others build the same skills I rely on every day.
      </p>
      <p>
        My academic background spans mathematics and economics. I have a B.Sc.
        in Mathematics from <inst-logo><ITBLogo /></inst-logo>Institut Teknologi
        Bandung, and a Master's in Economics and Finance from the
        <inst-logo><BSELogo /></inst-logo>Barcelona Graduate School of
        Economics. I am currently pursuing a Master's degree in Artificial
        Intelligence at <inst-logo><UdacityLogo /></inst-logo>Udacity.
      </p>
      <p>
        Feel free to reach out at
        <a href="mailto:akmal.fadhlurrahman@gmail.com"
          >akmal.fadhlurrahman@gmail.com</a
        >, or find me through the links below. I also occasionally write about
        data science, economics, and everything else on this blog; check out my
        recent posts below.
      </p>
    </prose-content>
    <hr>
    <section>
      <h2>Recent posts</h2>
      <ul>
        {recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}
              >{formatDate(post.data.date)}</time
            >
          </li>
        ))}
      </ul>
      <a class="all-posts" href="/blog">All posts <ArrowRight /></a>
    </section>
    <ascii-art aria-hidden="true"><pre>{asciiArt}</pre></ascii-art>
  </home-intro>
</Layout>

<style>
  home-intro {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-xs);
    }

    prose-content {
      display: block;

      p + p {
        margin-block-start: var(--space-xs);
      }

      inst-logo {
        display: inline-flex;
        align-items: center;
        vertical-align: -0.15em;
        block-size: 1em;
        margin-inline-end: 0.3em;

        :global(svg) {
          block-size: 100%;
          inline-size: auto;
          max-inline-size: 3em;
        }

        &.badge {
          border-radius: 0.2em;
          overflow: hidden;
        }

        &.nudge-up {
          vertical-align: 0;
        }
      }
    }

    hr {
      margin-block: var(--space-l);
      border: none;
      border-block-start: 2px solid var(--border);
    }

    section {
      h2 {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
        color: var(--foreground);
        margin-block-end: var(--space-s);
      }

      ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
      }

      li {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-s);

        a {
          color: var(--foreground);
        }

        time {
          flex-shrink: 0;
          font-size: var(--step--1);
          color: var(--muted-foreground);
        }
      }

      .all-posts {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-start: var(--space-s);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        &:hover {
          color: var(--foreground);
        }

        svg {
          inline-size: 1em;
          block-size: 1em;
        }
      }
    }

    ascii-art {
      display: block;
      container-type: inline-size;
      margin-block-start: var(--space-l);

      pre {
        font-family: var(--font-mono);
        font-size: 2.1cqw;
        line-height: 1.15;
        white-space: pre;
        overflow: hidden;
      }

      @media (width >= 64rem) {
        position: fixed;
        inset-block: var(--page-offset-top) var(--page-offset-bottom);
        inset-inline-end: var(--grid-edge);
        inline-size: calc(
          3 *
          var(--grid-column-width) +
          2 *
          var(--grid-gutter)
        );
        margin-block-start: 0;
        display: flex;
        align-items: center;
      }
    }
  }
</style>
